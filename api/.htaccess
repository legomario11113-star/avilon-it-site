# Настройки с паролем и шаблон не должны открываться из браузера.
<FilesMatch "^config(\.example)?\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Список файлов папки не показываем.
Options -Indexes
